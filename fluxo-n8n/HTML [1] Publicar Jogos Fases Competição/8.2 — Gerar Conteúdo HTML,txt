    }

    <div>

      <h2>
        ${esc(
          tr(
            'COMPETICOES',
            'COMPETICAO',
            competicao.nome,
            competicao.nome
          )
        )}

        ${esc(
          competicao.temporada || ''
        )}
      </h2>

      <p>

        ${esc(
          competicao.total_jogos || 0
        )}

        ${esc(
          tr(
            'COMPETICOES',
            'LABEL',
            'jogos_label',
            fb(
              'jogos_label',
              'jogos'
            )
          )
        )}

        ·

        ${esc(
          competicao.total_times || 0
        )}

        ${esc(
          tr(
            'COMPETICOES',
            'LABEL',
            'times_label',
            fb(
              'times_label',
