        conteudo_gerado: true,

        css_gerado: false,

        javascript_gerado: false,

        cache_salvo: false,

        fase_inicial: activeSlug,

        placar_regulamentar_pass_through: true,

        placar_regulamentar_prioridade: 'placar_normal_* > placar_regulamentar_* > placar_*'

