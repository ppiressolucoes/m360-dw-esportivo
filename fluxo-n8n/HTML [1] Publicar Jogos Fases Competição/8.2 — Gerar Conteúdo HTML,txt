function isOrigemGenerica(nome) {

  const v =
    String(nome || '')
      .trim()
      .toLowerCase();

  return (
    !v ||
    /^vencedor\s+/i.test(v) ||
    /^winner\s+/i.test(v) ||
    /^ganador\s+/i.test(v) ||
    /^perdedor\s+/i.test(v) ||
    /^loser\s+/i.test(v)
  );
}


function origemTraduzida(origem) {

  const valor =
    String(origem || '').trim();

  if (!valor) {
    return tr(
      'GLOBAL',
      'LABEL',
      'a_definir',
      fb('a_definir', 'A definir')
    );
  }

  const mVencedorPt =
    valor.match(/^Vencedor\s+(.+)$/i);

  if (mVencedorPt) {
    return `${tr(
      'COMPETICOES',
      'LABEL',
      'vencedor',
      fb('vencedor', 'Vencedor')
    )} ${mVencedorPt[1]}`;
  }

  const mPerdedorPt =
    valor.match(/^Perdedor\s+(.+)$/i);

  if (mPerdedorPt) {
    return `${tr(
      'COMPETICOES',
      'LABEL',
      'perdedor',
      fb('perdedor', 'Perdedor')
    )} ${mPerdedorPt[1]}`;
  }

  const mWinner =
    valor.match(/^Winner\s+(.+)$/i);

  if (mWinner) {
    return `${tr(
      'COMPETICOES',
      'LABEL',
      'vencedor',
      fb('vencedor', 'Vencedor')
    )} ${mWinner[1]}`;
  }

  const mLoser =
    valor.match(/^Loser\s+(.+)$/i);

  if (mLoser) {
    return `${tr(
      'COMPETICOES',
      'LABEL',
      'perdedor',
      fb('perdedor', 'Perdedor')
    )} ${mLoser[1]}`;
  }

  const mGanador =
    valor.match(/^Ganador\s+(.+)$/i);

  if (mGanador) {
    return `${tr(
      'COMPETICOES',
      'LABEL',
      'vencedor',
      fb('vencedor', 'Vencedor')
    )} ${mGanador[1]}`;
  }

  return valor;
}


function teamName(t, origem) {

  const nomeOriginal =
    String(t?.nome || '').trim();

  if (isOrigemGenerica(nomeOriginal)) {
    return origemTraduzida(nomeOriginal);
  }

  if (nomeOriginal) {
    return tr(
      'GLOBAL',
      'TIME',
      nomeOriginal,
      nomeOriginal
    );
  }

  return origemTraduzida(origem);
}


function teamShort(t, origem) {

  if (!t) {
    return origemTraduzida(origem);
  }

  const nome =
    String(t.sigla || t.abreviacao || t.nome || '').trim();

  if (!nome) {
    return origemTraduzida(origem);
  }

  if (isOrigemGenerica(nome)) {
    return origemTraduzida(nome);
  }

  return tr(
    'GLOBAL',
    'TIME',
    nome,
    nome
  );
}


function teamLogo(t, nome) {

  if (t?.escudo) {
    return `<img src="${esc(t.escudo)}" alt="${esc(nome)}">`;
  }

  return `<span class="m360-placeholder-logo"></span>`;
}


