function statusNormalizado(v) {

  return String(v || '')
    .trim()
    .toUpperCase();
}


function confrontoTemJogoAtivoOuAgendado(c) {

  const statuses = [
    c?.status,
    c?.status_confronto,
    c?.status_jogo_ida,
    c?.status_jogo_volta,
    c?.status_jogo_unico
  ]
    .map(statusNormalizado)
    .filter(Boolean);

  return statuses.some(s => [
    'SCHEDULED',
    'TIMED',
    'IN_PLAY',
    'LIVE',
    'PAUSED',
    'EM_ANDAMENTO',
    'AO_VIVO',
    'AGENDADO'
  ].includes(s));
}


function confrontoTemJogoFinalizado(c) {

  const statuses = [
    c?.status,
    c?.status_confronto,
    c?.status_jogo_ida,
    c?.status_jogo_volta,
    c?.status_jogo_unico
  ]
    .map(statusNormalizado)
    .filter(Boolean);

  return statuses.some(s => [
    'FINISHED',
    'FINALIZADO',
    'ENCERRADO',
    'COMPLETED'
  ].includes(s));
}


function faseTemStatus(fase, fn) {

  const lista =
    Array.isArray(mata[fase.key])
      ? mata[fase.key]
      : [];

  return lista.some(fn);
}


function determinarFaseInicial() {

  if (isLiga) {
    return fasesConfig[0]?.slug || 'grupos';
  }

  // A fase atual é a PRIMEIRA fase, na ordem natural da
  // competição, que possui jogo ativo/agendado.
  //
  // Não usar ordem reversa aqui: uma FINAL futura pode possuir
  // jogo agendado e não deve ultrapassar uma OITAVAS atual.
  for (let i = 0; i < fasesConfig.length; i++) {

    const fase = fasesConfig[i];

    if (faseTemStatus(
      fase,
      confrontoTemJogoAtivoOuAgendado
    )) {
      return fase.slug;
    }
  }

  // Se não houver jogo ativo/agendado, abre a última fase
  // que já possui jogo finalizado.
  for (let i = fasesConfig.length - 1; i >= 0; i--) {

    const fase = fasesConfig[i];

    if (faseTemStatus(
      fase,
      confrontoTemJogoFinalizado
    )) {
      return fase.slug;
    }
  }

  return fasesConfig[0]?.slug || 'grupos';
}


const activeSlug =
  determinarFaseInicial();


const conteudoHTML = `

  <div class="m360-header">

    ${
      competicao.logo_url
        ? `<img
            src="${esc(competicao.logo_url)}"
