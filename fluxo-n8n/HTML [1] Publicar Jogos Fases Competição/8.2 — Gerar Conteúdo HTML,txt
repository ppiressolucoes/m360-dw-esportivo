function renderLeg(c, tipo) {

  const isVolta =
    tipo === 'volta';

  const mandante =
    isVolta
      ? c.time_b
      : c.time_a;

  const visitante =
    isVolta
      ? c.time_a
      : c.time_b;

  const origemMandante =
    isVolta
      ? c.origem_time_b
      : c.origem_time_a;

  const origemVisitante =
    isVolta
      ? c.origem_time_a
      : c.origem_time_b;

  const data =
    isVolta
      ? c.data_volta
      : c.data_ida;

  const dataIso =
    isVolta
      ? (
          c.data_volta_iso ||
          c.data_segundo_jogo
        )
      : (
          c.data_ida_iso ||
          c.data_primeiro_jogo
        );

  const horario =
    fmtHora(dataIso);

  const jogoUnico =
    Number(c.possui_volta) === 0 ||
    Boolean(c.jogo_unico_uid);

  const estadio =
    isVolta
      ? c.estadio_volta_nome
      : (
          jogoUnico
            ? c.estadio_unico_nome
            : c.estadio_ida_nome
        );

  // ----------------------------------------------------------
  // PLACAR REGULAMENTAR — PRIORIDADE ABSOLUTA
  //
  // O Node 8.1 v2 entrega explicitamente o placar regulamentar
  // nos campos placar_normal_* / placar_regulamentar_*.
  //
  // REGRA DE PUBLICAÇÃO:
  // 1. placar_normal_*
  // 2. placar_regulamentar_*
  // 3. placar_* legado, somente se os anteriores não existirem
  //
  // Quando houver pênaltis, o placar principal NUNCA usa
  // gols_time_a/b nem placar agregado do confronto.
  // Os pênaltis continuam sendo apresentados separadamente
  // pelo Node 8.3.
  //
  // O 8.2 NÃO calcula, subtrai ou reconstrói placares.
  // Apenas publica os campos normalizados recebidos do 8.1.
  // ----------------------------------------------------------

  const pm =
    isVolta
      ? (
          c?.placar_normal_volta_mandante ??
          c?.placar_regulamentar_volta_mandante ??
          c?.placar_volta_mandante ??
          null
        )
      : (
          c?.placar_normal_ida_mandante ??
          c?.placar_regulamentar_ida_mandante ??
          c?.placar_ida_mandante ??
          null
        );

  const pv =
    isVolta
      ? (
          c?.placar_normal_volta_visitante ??
          c?.placar_regulamentar_volta_visitante ??
          c?.placar_volta_visitante ??
          null
        )
      : (
          c?.placar_normal_ida_visitante ??
          c?.placar_regulamentar_ida_visitante ??
          c?.placar_ida_visitante ??
          null
        );

  return `
    <div class="m360-ko-leg">

      <div class="m360-ko-leg-head">

        ${esc(
          isVolta
            ? tr(
                'COMPETICOES',
                'LABEL',
                'volta',
                fb('volta', 'VOLTA')
              )
            : tr(
                'COMPETICOES',
                'LABEL',
                'jogo',
                fb('jogo', 'JOGO')
              )
        )}

      </div>

      <div class="m360-ko-meta">

        ${
          data
            ? `<strong>
                ${esc(data)}
                ${
                  horario
                    ? ` · ${esc(horario)}`
                    : ''
                }
              </strong>`
            : ''
        }

        ${
          estadio
            ? `<span>
                 · ${esc(estadio)}
               </span>`
            : ''
        }

      </div>

      <div class="m360-ko-match">

        ${renderTime(
          mandante,
          origemMandante
        )}

        <div class="m360-ko-score">
          ${score(pm)}
          x
          ${score(pv)}
        </div>

        ${renderTime(
          visitante,
          origemVisitante
        )}

      </div>

    </div>
  `;
}


function getFallbackDates(lista) {

  const ref =
    (lista || []).find(c =>
      c.data_ida ||
      c.data_volta ||
      c.data_primeiro_jogo ||
      c.data_segundo_jogo
    );

  return {

    data_ida:
      ref?.data_ida ||
      fmtData(ref?.data_primeiro_jogo) ||
      '',

    data_volta:
      ref?.data_volta ||
      fmtData(ref?.data_segundo_jogo) ||
      ''
  };
}


function renderMataFase(lista, vazioTexto) {

  if (!lista || !lista.length) {

    return `
      <p class="m360-empty">
        ${esc(
          vazioTexto ||
          fb(
            'fase_indisponivel',
            'Fase ainda não disponível.'
          )
        )}
      </p>
    `;
  }

  const fallback =
    getFallbackDates(lista);

  return `
    <div class="m360-ko-list">

      ${lista.map(c => {

        const dataIda =
          c.data_ida ||
          fmtData(c.data_primeiro_jogo) ||
          fallback.data_ida;

        const dataVolta =
          c.data_volta ||
          fmtData(c.data_segundo_jogo) ||
          fallback.data_volta;

        const jogoUnico =
          c.fase === 'FINAL' ||
          c.fase_slug === 'final' ||
          Number(c.possui_volta) === 0 ||
          Boolean(c.jogo_unico_uid);

        const confronto = {
          ...c,

          data_ida: dataIda,
          data_volta: dataVolta,

          // ----------------------------------------------------
          // PLACAR REGULAMENTAR — PASS-THROUGH
          //
          // O 8.2 não inventa nem recalcula placares.
          // Apenas normaliza aliases caso o Node 8.1/DW já os
          // entregue separados dos pênaltis.
          // ----------------------------------------------------
          placar_normal_ida_mandante:
            c?.placar_normal_ida_mandante ??
            c?.placar_regulamentar_ida_mandante ??
            null,

          placar_normal_ida_visitante:
            c?.placar_normal_ida_visitante ??
            c?.placar_regulamentar_ida_visitante ??
            null,

          placar_normal_volta_mandante:
            c?.placar_normal_volta_mandante ??
            c?.placar_regulamentar_volta_mandante ??
            null,

          placar_normal_volta_visitante:
            c?.placar_normal_volta_visitante ??
            c?.placar_regulamentar_volta_visitante ??
            null,

          placar_normal_unico_mandante:
            c?.placar_normal_unico_mandante ??
            c?.placar_regulamentar_unico_mandante ??
            null,

          placar_normal_unico_visitante:
            c?.placar_normal_unico_visitante ??
            c?.placar_regulamentar_unico_visitante ??
            null
        };

        return `

          <div class="m360-ko-card">

            <div class="m360-ko-key">

              ${esc(
                confronto.chave || ''
              )}

              ·

              ${esc(
                statusLabel(
                  confronto.status ||
                  confronto.status_confronto ||
                  ''
                )
              )}

            </div>

            ${
              jogoUnico

                ? renderLeg(
                    confronto,
                    'ida'
                  )

                : `
                  <div class="m360-ko-two-cols">

                    ${renderLeg(
                      confronto,
                      'ida'
                    )}

                    ${renderLeg(
                      confronto,
                      'volta'
                    )}

                  </div>
                `
            }

          </div>
        `;

      }).join('')}

    </div>
  `;
}


