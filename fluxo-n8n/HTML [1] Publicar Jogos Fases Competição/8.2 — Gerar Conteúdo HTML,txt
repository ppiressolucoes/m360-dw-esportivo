function getLigaRodadaInicial(rodadas) {

  if (!rodadas.length) {
    return 0;
  }

  const aberta =
    rodadas.findIndex(r =>
      (r.jogos || []).some(j =>
        [
          'TIMED',
          'SCHEDULED',
          'IN_PLAY'
        ].includes(
          String(j.status || '').toUpperCase()
        )
      )
    );

  if (aberta >= 0) {
    return aberta;
  }

  const ultimaFinalizada =
    [...rodadas]
      .map((r, index) => ({
        r,
        index
      }))
      .filter(x =>
        (x.r.jogos || []).some(j =>
          String(j.status || '').toUpperCase() === 'FINISHED'
        )
      )
      .pop();

  return ultimaFinalizada
    ? ultimaFinalizada.index
    : 0;
}


