        </div>

        ${fasesConfig.map(f => `

          <section
            id="${esc(f.id)}"
            class="m360-section ${
              f.slug === activeSlug
                ? 'active'
                : ''
            }"
          >
            ${f.html}
          </section>

        `).join('')}

      `
  }

`;


// ============================================================
// 15. METADADOS PARA O NODE 8.3
// ============================================================

const fases = fasesConfig.map(f => ({

  key: f.key,

  slug: f.slug,

  title: f.title,

  id: f.id,

  enabled: Boolean(f.enabled)

}));


// ============================================================
// 16. SAÍDA
// ============================================================
//
// O 8.3 receberá:
// - dados originais
// - conteúdo HTML
// - configuração das fases
// - flags de modelo
//
// Não salva cache.
// ============================================================

return [

  {

    json: {

      competicao,

      classificacao,

      grupos,

      mata_mata: mata,

      liga,

      tipo_publicacao,

      idioma,

      i18n,

      widget_nome:
