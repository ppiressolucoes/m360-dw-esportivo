// ============================================================
// 7. RODADAS
// ============================================================

function rodadaNumero(v) {

  const m =
    String(v || '')
      .match(/\d+/);

  return m
    ? Number(m[0])
    : 9999;
}


function rodadaNomeTraduzida(nome, grupo = false) {

  const valor =
    String(nome || '').trim();

  if (!valor) {
    return fb(
      grupo
        ? 'rodada_grupo'
        : 'rodada',
      grupo
        ? 'Rodada'
        : 'Rodada'
    );
  }

  const numero =
    rodadaNumero(valor);

  if (
    Number.isFinite(numero) &&
    numero !== 9999
  ) {
    return `${fb(
      grupo
        ? 'rodada_grupo'
        : 'rodada',
      'Rodada'
    )} ${numero}`;
  }

  return valor;
}


function grupoNomeTraduzido(grupoKey, grupoData) {

  const nome =
    String(
      grupoData?.nome ||
      grupoData?.grupo ||
      grupoKey ||
      ''
    ).trim();

  if (!nome) {
    return fb('grupo', 'Grupo');
  }

  const m =
    nome.match(/^Grupo\s+(.+)$/i);

  if (m) {
    return `${fb('grupo', 'Grupo')} ${m[1]}`;
  }

  return nome;
}


