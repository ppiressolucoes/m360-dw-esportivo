// ============================================================
// 3. I18N
// ============================================================

function fb(chave, fallbackPt = '') {
  return (
    M360_FALLBACKS[idioma]?.[chave] ||
    M360_FALLBACKS['pt-BR']?.[chave] ||
    fallbackPt ||
    chave ||
    ''
  );
}


function tr(modulo, tipo, chave, fallback) {

  const chaveStr =
    String(chave || '').trim();

  if (!chaveStr) {
    return fallback || '';
  }

  const k1 =
    [modulo || 'GLOBAL', tipo, chaveStr, idioma].join('|');

  const k2 =
    ['GLOBAL', tipo, chaveStr, idioma].join('|');

  const k3 =
    [modulo || 'GLOBAL', tipo, chaveStr, 'pt-BR'].join('|');

  const k4 =
    ['GLOBAL', tipo, chaveStr, 'pt-BR'].join('|');

  return (
    i18n[k1]?.texto_exibicao ||
    i18n[k2]?.texto_exibicao ||
    fallback ||
    i18n[k3]?.texto_exibicao ||
    i18n[k4]?.texto_exibicao ||
    chaveStr
  );
}


function trCurto(modulo, tipo, chave, fallback) {

  const chaveStr =
    String(chave || '').trim();

  if (!chaveStr) {
    return fallback || '';
  }

  const k1 =
    [modulo || 'GLOBAL', tipo, chaveStr, idioma].join('|');

  const k2 =
    ['GLOBAL', tipo, chaveStr, idioma].join('|');

  const k3 =
    [modulo || 'GLOBAL', tipo, chaveStr, 'pt-BR'].join('|');

  const k4 =
    ['GLOBAL', tipo, chaveStr, 'pt-BR'].join('|');

  return (
    i18n[k1]?.texto_curto ||
    i18n[k2]?.texto_curto ||
    fallback ||
    i18n[k3]?.texto_curto ||
    i18n[k4]?.texto_curto ||
    chaveStr
  );
}


function colCurta(chave, fallback) {
  return trCurto(
    'COMPETICOES',
    'COLUNA',
    chave,
    fb(chave, fallback)
  );
}


// ============================================================
// 4. UTILITÁRIOS
// ============================================================

function esc(v) {

  return String(v ?? '')
    .replace(/[&<>"']/g, m => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[m]));
}


function localeAtual() {

  if (idioma === 'en-US') {
    return 'en-US';
  }

  if (idioma === 'es-ES') {
    return 'es-ES';
  }

  return 'pt-BR';
}


function fmtData(v) {

  if (!v) {
    return '';
  }

  const d = new Date(v);

  if (Number.isNaN(d.getTime())) {
    return esc(v);
  }

  return d.toLocaleDateString(
    localeAtual(),
    {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric'
    }
  );
}


function fmtHora(v) {

  if (!v) {
    return '';
  }

  const d = new Date(v);

  if (Number.isNaN(d.getTime())) {
    return '';
  }

  return d.toLocaleTimeString(
    localeAtual(),
    {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    }
  );
}


function fmtDataHora(v) {

  if (!v) {
    return '';
  }

  const d = new Date(v);

  if (Number.isNaN(d.getTime())) {
    return esc(v);
  }

  return d.toLocaleString(
    localeAtual(),
    {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false
    }
  );
}


function score(v) {

  if (
    v === null ||
    v === undefined ||
    v === ''
  ) {
    return '-';
  }

  return String(v);
}


