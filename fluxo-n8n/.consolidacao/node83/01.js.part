// ============================================================
// MENGÃO 360
// HTML [1] - Publicar Jogos Fases Competição
//
// NODE 8.3 — APLICAR CSS + JAVASCRIPT
// VERSÃO: HTML1_MODULAR_v1_8.3.2
//
// Base homologada:
//   Node 8.1 -> Preparar Dados
//   Node 8.2 -> Gerar Conteúdo HTML
//   Node 8.3 -> CSS + JavaScript
//   Node 8.4 -> Validar / Preparar Widget
//
// AJUSTE DESTA VERSÃO:
// - Corrige exclusivamente o layout de PONTOS_CORRIDOS.
// - Mantém tabela + agenda lado a lado no desktop.
// - Mantém proporção aproximada 70% / 30%.
// - Corrige o cálculo de largura causado por 70% + 30% + gap.
// - A coluna de agenda só passa para baixo no mobile.
// - Não altera dados, classificação, placares, fases ou DW.
// - Não altera o comportamento visual homologado das copas.
// - Mantém navegação de fases, rodadas, pênaltis e status.
// ============================================================


const data = items[0]?.json || {};


// ============================================================
// 1. DADOS RECEBIDOS
// ============================================================

const conteudoHTML =
  String(
    data.conteudoHTML ||
    data.html ||
    ''
  );

const fases =
  Array.isArray(data.fases)
    ? data.fases
    : [];

const activeSlug =
  data.activeSlug ||
  fases[0]?.slug ||
  'grupos';

const isLiga =
  Boolean(data.isLiga);


// ============================================================
// 2. LIMPEZA PREVENTIVA
//
// O Node 8.2 entrega somente HTML estrutural.
// Removemos CSS/JS eventualmente herdados de versões antigas.
// ============================================================

let htmlBase =
  conteudoHTML
    .replace(
      /<style[\s\S]*?<\/style>/gi,
      ''
    )
    .replace(
      /<script[\s\S]*?<\/script>/gi,
      ''
    )
    .trim();


// ============================================================
// 3. NORMALIZAÇÃO DAS FASES PARA JAVASCRIPT
// ============================================================

const fasesJS =
  fases.map(f => ({

    key:
      String(f.key || ''),

    slug:
      String(f.slug || ''),

    title:
      String(f.title || ''),

    id:
      String(f.id || ''),

    enabled:
      Boolean(f.enabled)

  }));


// ============================================================
// 3.1 DADOS DO MATA-MATA
//
// O Node 8.3 não recalcula resultado.
// Apenas apresenta informações já consolidadas pelo 8.2/DW.
// ============================================================

const mataMataFonte =
  data.mata_mata || {};

const mataMataJS = [

  ...(Array.isArray(mataMataFonte.fase_32)
    ? mataMataFonte.fase_32
    : []),

  ...(Array.isArray(mataMataFonte.oitavas)
    ? mataMataFonte.oitavas
    : []),

  ...(Array.isArray(mataMataFonte.quartas)
    ? mataMataFonte.quartas
    : []),

  ...(Array.isArray(mataMataFonte.semifinais)
    ? mataMataFonte.semifinais
    : []),

  ...(Array.isArray(mataMataFonte.terceiro_lugar)
    ? mataMataFonte.terceiro_lugar
    : []),

  ...(Array.isArray(mataMataFonte.final)
    ? mataMataFonte.final
    : [])

].map(c => ({

  chave:
    String(c?.chave || ''),

  possui_volta:
    Number(c?.possui_volta || 0),

  jogo_unico_uid:
    c?.jogo_unico_uid || null,

  penalti_time_a:
    c?.penalti_time_a ?? null,

  penalti_time_b:
    c?.penalti_time_b ?? null,

  status:
    String(
      c?.status ||
      c?.status_confronto ||
      ''
    ),

  status_jogo_ida:
    String(
      c?.status_jogo_ida ||
      ''
    ),

  status_jogo_volta:
    String(
      c?.status_jogo_volta ||
      ''
    ),

  status_jogo_unico:
    String(
      c?.status_jogo_unico ||
      ''
    ),

  placar_ida_mandante:
    c?.placar_ida_mandante ?? null,

  placar_ida_visitante:
    c?.placar_ida_visitante ?? null,

  placar_volta_mandante:
    c?.placar_volta_mandante ?? null,

  placar_volta_visitante:
    c?.placar_volta_visitante ?? null,

  placar_unico_mandante:
    c?.placar_unico_mandante ?? null,

  placar_unico_visitante:
    c?.placar_unico_visitante ?? null

}));


// ============================================================
// 4. CSS
//
// IMPORTANTE:
// A correção de PONTOS_CORRIDOS está isolada em:
//   .m360-league-layout
//   .m360-league-main
//   .m360-league-side
//
// O layout de grupos/mata-mata permanece separado.
// ============================================================

const css = `

<style data-m360-stage="8.3">

/* =========================================================
   VARIÁVEIS / BASE
   ========================================================= */

.m360-competicao{

  --m360-text:#333;
  --m360-muted:#777;
  --m360-border:#d9d9d9;
  --m360-soft:#f5f5f5;
  --m360-accent:#d71920;

  width:100%;
  max-width:100%;

  min-width:0;

  margin:0;
  padding:4px 0 20px;

  overflow:hidden;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  box-sizing:border-box;

}

.m360-competicao *,
.m360-competicao *::before,
.m360-competicao *::after{

  box-sizing:border-box;

}

.m360-competicao{

  color:var(--m360-text);

}

.m360-competicao img{

  max-width:100%;

}


/* =========================================================
   CABEÇALHO
   ========================================================= */

.m360-header{

  display:flex;

  align-items:center;

  gap:12px;

  width:100%;

  min-width:0;

  margin:0 0 18px;

  padding:14px;

  border:1px solid var(--m360-border);

  border-radius:14px;

  background:transparent;

  overflow:hidden;

}

.m360-header img{

  width:54px;
  height:54px;

  flex:0 0 54px;

  object-fit:contain;

}

.m360-header > div{

  min-width:0;

}

.m360-header h2{

  margin:0 0 4px;

  color:var(--m360-text);

  font-size:24px;

  line-height:1.2;

  font-weight:800;

}

.m360-header p{

  margin:0;

  color:var(--m360-muted);

  font-size:14px;

  line-height:1.3;

}


/* =========================================================
   NAVEGAÇÃO DE FASES
   ========================================================= */

.m360-stage-nav{

  display:grid !important;

  grid-template-columns:
    40px
    minmax(0,1fr)
    40px !important;

  align-items:center !important;

  gap:12px !important;

  width:100% !important;

  min-width:0 !important;

  margin:0 0 22px !important;

  padding:0 !important;

}

.m360-stage-btn{

  appearance:none !important;

  display:flex !important;

  align-items:center !important;

  justify-content:center !important;

  width:40px !important;
  min-width:40px !important;
  max-width:40px !important;

  height:40px !important;
  min-height:40px !important;

  flex:0 0 40px !important;

  margin:0 !important;
  padding:0 !important;

  border:0 !important;

  border-radius:4px !important;

  background:var(--m360-accent) !important;

  color:#fff !important;

  font-size:26px !important;

  line-height:1 !important;

  cursor:pointer;

  overflow:hidden;

}

.m360-stage-btn:hover{

  opacity:.88;

}

.m360-stage-title{

  min-width:0 !important;

  width:100% !important;

  text-align:center !important;

  white-space:nowrap !important;

  overflow:hidden !important;

  text-overflow:ellipsis !important;

  color:var(--m360-text);

  font-size:23px;

  line-height:1.2;

  font-weight:800;

  letter-spacing:.3px;

}


/* =========================================================
   FASES
   ========================================================= */

.m360-section{

  display:none !important;

  width:100% !important;

  min-width:0 !important;

  margin:0 !important;

  padding:0 !important;

}

.m360-section.active{

  display:block !important;

}


/* =========================================================
   =========================================================
   PONTOS CORRIDOS / LIGA
   =========================================================
   ========================================================= */

/*
 * CORREÇÃO PRINCIPAL
 *
 * Não utilizar:
 *
 *   70% + 30% + gap
 *
 * porque isso ultrapassa a largura disponível.
 *
 * Usamos 7fr / 3fr:
 *
 *   classificação ≈ 70%
 *   agenda        ≈ 30%
 *
 * O minmax(260px,3fr) garante uma largura mínima funcional
 * para a agenda no desktop.
 */

.m360-league-layout{

  display:grid !important;

  grid-template-columns:
    minmax(0,7fr)
    minmax(260px,3fr) !important;

  align-items:start !important;

  column-gap:24px !important;

  row-gap:20px !important;

  width:100% !important;

  max-width:100% !important;

  min-width:0 !important;

  overflow:visible !important;

}

.m360-league-main{

  display:block;

  width:100% !important;

  max-width:100% !important;

  min-width:0 !important;

  overflow:hidden !important;

}

.m360-league-side{

  display:block;

  width:100% !important;

  max-width:100% !important;

  min-width:0 !important;

  overflow:hidden !important;

  border-left:1px solid var(--m360-border);

  padding-left:24px;

}

/*
 * Títulos da liga.
 */

.m360-league-title{

  margin:0 0 16px;

  padding:0 0 12px;

  border-bottom:1px solid var(--m360-border);

  color:var(--m360-text);

  font-size:22px;

  line-height:1.2;

  font-weight:800;

  letter-spacing:.4px;

  text-transform:uppercase;

}


/*
 * A tabela pode ser mais larga que a coluna.
 * O scroll horizontal fica somente dentro da tabela,
 * nunca sobre o layout principal.
 */

.m360-league-table-scroll{

  width:100% !important;

  max-width:100% !important;

  min-width:0 !important;

  overflow-x:auto !important;

  overflow-y:hidden !important;

  -webkit-overflow-scrolling:touch;

}


/* =========================================================
   GRUPOS
   ========================================================= */

.m360-group-block{

  width:100%;

  min-width:0;

  margin:0 0 30px;

}

.m360-group-block > h3{

  margin:0 0 14px;

  color:var(--m360-text);

  font-size:25px;

  line-height:1.2;

  font-weight:800;

}


/*
 * Layout usado pela fase de grupos.
 *
 * Mantido independente do layout de liga.
 */

.m360-group-layout{

  display:grid !important;

  grid-template-columns:
    minmax(0,7fr)
    minmax(260px,3fr) !important;

  gap:20px !important;

  width:100% !important;

  min-width:0 !important;

  align-items:start !important;

}

.m360-group-main{

  min-width:0 !important;

  width:100% !important;

}

.m360-group-side{

  min-width:0 !important;

  width:100% !important;

}


/* =========================================================
   TABELAS
   ========================================================= */

.m360-table{

  width:100%;

  border-collapse:collapse;

  table-layout:fixed;

  font-size:14px;

}

.m360-table th,
.m360-table td{

  border:1px solid var(--m360-border);

  padding:8px 7px;

  text-align:center;

  vertical-align:middle;

}

.m360-table th{

  background:var(--m360-soft);

  color:var(--m360-text);

  font-weight:800;

  text-transform:uppercase;

  font-size:12px;

}

.m360-table td:first-child,
.m360-table th:first-child{

  width:42px;

}

.m360-table td:nth-child(2),
.m360-table th:nth-child(2){

  text-align:left;

}

.m360-table-team{

  display:flex;

  align-items:center;

  gap:8px;

  min-width:0;

}

.m360-table-team img{

  width:28px;
  height:28px;

  flex:0 0 28px;

  object-fit:contain;

}

.m360-table-team span{

  min-width:0;

  overflow:hidden;

  text-overflow:ellipsis;

  white-space:nowrap;

}


/* =========================================================
   RODADAS
   ========================================================= */

.m360-round-widget{

  width:100%;

  min-width:0;

}

.m360-round-nav{

  display:grid;

  grid-template-columns:36px minmax(0,1fr) 36px;

  align-items:center;

  gap:8px;

  width:100%;

  margin:0 0 10px;

}

.m360-round-btn{

  display:flex;

  align-items:center;

  justify-content:center;

  width:36px;
  height:36px;

  padding:0;

  border:0;

  border-radius:4px;

  background:var(--m360-accent);

  color:#fff;

  font-size:22px;

  line-height:1;

  cursor:pointer;

}

.m360-round-title{

  min-width:0;

  text-align:center;

  color:var(--m360-text);

  font-size:18px;

  line-height:1.2;

  font-weight:800;

  white-space:nowrap;

  overflow:hidden;

  text-overflow:ellipsis;

}

.m360-round-panel{

  display:none;

  width:100%;

}

.m360-round-panel.active{

  display:block;

}

.m360-round-match{

  width:100%;

  margin:0 0 12px;

  padding:10px;

  border-bottom:1px solid var(--m360-border);

}

.m360-round-date{

  margin:0 0 8px;

  text-align:center;

  color:var(--m360-muted);

  font-size:12px;

}

.m360-round-scoreline{

  display:grid;

  grid-template-columns:
    minmax(0,1fr)
    50px
    minmax(0,1fr);

  align-items:center;

  gap:10px;

  width:100%;

}

.m360-round-team{

  display:flex;

  align-items:center;

  gap:8px;

  min-width:0;

}

.m360-round-team.home{

  justify-content:flex-end;

  text-align:right;

}

.m360-round-team.away{

  justify-content:flex-start;

  text-align:left;

}

.m360-round-team img{

  width:30px;
  height:30px;

  flex:0 0 30px;

  object-fit:contain;

}

.m360-round-team span{

  min-width:0;

  overflow:hidden;

  text-overflow:ellipsis;

  white-space:nowrap;

  font-size:13px;

}

.m360-round-score{

  display:flex;

  flex-direction:column;

  align-items:center;

  justify-content:center;

  min-width:0;

  color:var(--m360-text);

  font-size:16px;

  line-height:1.2;

  font-weight:800;

}

.m360-round-status{

  margin-top:3px;

  color:var(--m360-accent);

  font-size:10px;

  line-height:1.1;

  font-weight:800;

  text-transform:uppercase;

}


/* =========================================================
   MATA-MATA
   ========================================================= */

.m360-ko-list{

  display:flex;

  flex-direction:column;

  gap:18px;

  width:100%;

}

.m360-ko-card{

  width:100%;

  min-width:0;

  border:1px solid var(--m360-border);

  border-radius:12px;

  overflow:hidden;

  background:transparent;

}

.m360-ko-header{

  display:flex;

  align-items:center;

  justify-content:center;

  min-height:38px;

  padding:8px 12px;

  border-bottom:1px solid var(--m360-border);

  color:var(--m360-text);

  font-size:13px;

  line-height:1.2;

  font-weight:800;

  text-transform:uppercase;

}

.m360-ko-legs{

  display:grid;

  grid-template-columns:
    minmax(0,1fr)
    minmax(0,1fr);

  width:100%;

  min-width:0;

}

.m360-ko-leg{

  min-width:0;

  padding:14px;

}

.m360-ko-leg + .m360-ko-leg{

  border-left:1px solid var(--m360-border);

}

.m360-ko-leg-title{

  margin:0 0 8px;

  text-align:center;

  color:var(--m360-muted);

  font-size:11px;

  line-height:1.2;

  font-weight:800;

  text-transform:uppercase;

}

.m360-ko-date{

  margin:0 0 12px;

  text-align:center;

  color:var(--m360-text);

  font-size:12px;

  line-height:1.2;

  font-weight:700;

}

.m360-ko-match{

  display:grid;

  grid-template-columns:
    minmax(0,1fr)
    50px
    minmax(0,1fr);

  align-items:center;

  gap:10px;

  width:100%;

}

.m360-ko-team{

  display:flex;

  align-items:center;

  gap:8px;

  min-width:0;

}

.m360-ko-team.home{

  justify-content:flex-end;

  text-align:right;

}

.m360-ko-team.away{

  justify-content:flex-start;

  text-align:left;

}

.m360-ko-team img{

  width:32px;
  height:32px;

  flex:0 0 32px;

  object-fit:contain;

}

.m360-ko-team span{

  min-width:0;

  overflow:hidden;

  text-overflow:ellipsis;

  white-space:nowrap;

  font-size:13px;

}

.m360-ko-score{

  display:flex;

  flex-direction:column;

  align-items:center;

  justify-content:center;

  min-width:0;

  color:var(--m360-text);

  font-size:16px;

  line-height:1.2;

  font-weight:800;

}

.m360-ko-penalties{

  display:block;

  margin-top:4px;

  color:var(--m360-muted);

  font-size:10px;

  line-height:1.1;

  font-weight:700;

  white-space:nowrap;

}

.m360-ko-status{

  display:block;

  margin-top:4px;

  color:var(--m360-accent);

  font-size:10px;

  line-height:1.1;

  font-weight:800;

  text-transform:uppercase;

}


/* =========================================================
   RESPONSIVIDADE
   ========================================================= */

@media (max-width:900px){

  .m360-league-layout,
  .m360-group-layout{

    grid-template-columns:
      minmax(0,1fr) !important;

  }

  .m360-league-side{

    border-left:0;

    border-top:1px solid var(--m360-border);

    padding-left:0;

    padding-top:18px;

  }

  .m360-group-side{

    border-top:1px solid var(--m360-border);

    padding-top:18px;

  }

}

@media (max-width:700px){

  .m360-header{

    padding:10px;

  }

  .m360-header img{

    width:46px;
    height:46px;

    flex-basis:46px;

  }

  .m360-header h2{

    font-size:20px;

  }

  .m360-stage-title{

    font-size:19px;

  }

  .m360-table{

    font-size:12px;

  }

  .m360-table th,
  .m360-table td{

    padding:6px 5px;

  }

  .m360-table-team img{

    width:24px;
    height:24px;

    flex-basis:24px;

  }

  .m360-ko-legs{

    grid-template-columns:
      minmax(0,1fr);

  }

  .m360-ko-leg + .m360-ko-leg{

    border-left:0;

    border-top:1px solid var(--m360-border);

  }

  .m360-round-title{

    font-size:15px !important;

    line-height:34px !important;

  }

  .m360-round-scoreline{

    grid-template-columns:
      minmax(0,1fr)
      44px
      minmax(0,1fr) !important;

  }

  .m360-round-team span{

    font-size:12px;

  }

  .m360-round-team img{

    width:24px;
    height:24px;

    flex-basis:24px;

  }

  .m360-ko-match{

    grid-template-columns:
      minmax(0,1fr)
      46px
      minmax(0,1fr) !important;

  }

}


/* =========================================================
   FIM CSS
   ========================================================= */

</style>
`;


// ============================================================
// 5. JAVASCRIPT
//
// Responsabilidades:
// - navegação entre fases
// - navegação entre rodadas
// - apresentação de pênaltis
// - apresentação de status adiado
// - compatibilidade Elementor
//
// Não altera dados.
// ============================================================

const javascript = `

<script data-m360-stage="8.3">

(function(){

  'use strict';


  const fases =
    ${JSON.stringify(fasesJS)};


  const activeSlug =
    ${JSON.stringify(activeSlug)};


  const isLiga =
    ${JSON.stringify(isLiga)};


  const idioma =
    ${JSON.stringify(data.idioma || 'pt-BR')};


  const mataMata =
    ${JSON.stringify(mataMataJS)};


  /* =======================================================
     HELPERS
     ======================================================= */

  function valorExiste(v){

    return !(
      v === null ||
      v === undefined ||
      v === ''
    );

  }


  /* =======================================================
     PÊNALTIS
     ======================================================= */

  function adicionarPenaltis(
    scoreNode,
    confronto,
    isVolta
  ){

    if (
      !scoreNode ||
      !confronto
    ){

      return;

    }


    if (
      !valorExiste(
        confronto.penalti_time_a
      ) ||
      !valorExiste(
        confronto.penalti_time_b
      )
    ){

      return;

    }


    if (
      scoreNode.querySelector(
        '.m360-ko-penalties'
      )
    ){

      return;

    }


    const penA =
      String(
        confronto.penalti_time_a
      );


    const penB =
      String(
        confronto.penalti_time_b
      );


    /*
     * Na volta a ordem visual é:
     * time B x time A.
     */

    const esquerda =
      isVolta
        ? penB
        : penA;


    const direita =
      isVolta
        ? penA
        : penB;


    const el =
      document.createElement(
        'span'
      );


    el.className =
      'm360-ko-penalties';


    const label =
      idioma === 'en-US'
        ? 'Penalties'
        : idioma === 'es-ES'
          ? 'Penaltis'
          : 'Pênaltis';


    el.textContent =
      label +
      ' ' +
      esquerda +
      ' x ' +
      direita;


    scoreNode.appendChild(
      el
    );

  }


  /* =======================================================
     STATUS DO JOGO
     ======================================================= */

  function adicionarStatusJogo(
    legNode,
    status
  ){

    if (
      !legNode ||
      !status
    ){

      return;

    }


    const normalizado =
      String(status)
        .trim()
        .toUpperCase();


    if (
      ![
        'POSTPONED',
        'CANCELLED',
        'SUSPENDED',
        'ADIADO',
        'CANCELADO',
        'SUSPENSO'
      ].includes(
        normalizado
      )
    ){

      return;

    }


    if (
      legNode.querySelector(
        '.m360-round-status, .m360-ko-status'
      )
    ){

      return;

    }


    const el =
      document.createElement(
        'span'
      );


    el.className =
      'm360-ko-status';


    const label =
      idioma === 'en-US'
        ? 'POSTPONED'
        : idioma === 'es-ES'
          ? 'APLAZADO'
          : 'ADIADO';


    el.textContent =
      label;


    const score =
      legNode.querySelector(
        '.m360-ko-score'
      );


    if (score){

      score.appendChild(
        el
      );

    } else {

      legNode.appendChild(
        el
      );

    }

  }


  /* =======================================================
     LOCALIZA CONFRONTO
     ======================================================= */

  function localizarConfronto(
    card
  ){

    if (!card){

      return null;

    }


    const chave =
      String(
        card.dataset.chave ||
        ''
      );


    if (!chave){

      return null;

    }


    return mataMata.find(
      function(c){

        return (
          String(c.chave || '') ===
          chave
        );

      }
    ) || null;

  }


  /* =======================================================
     APLICAR DADOS DO MATA-MATA
     ======================================================= */

  function aplicarDadosMataMata(
    root
  ){

    root
      .querySelectorAll(
        '.m360-ko-card'
      )
      .forEach(
        function(card){

          const confronto =
            localizarConfronto(
              card
            );


          if (!confronto){

            return;

          }


          const legs =
            Array.from(
              card.querySelectorAll(
                '.m360-ko-leg'
              )
            );


          if (!legs.length){

            return;

          }


          /*
           * Ida:
           * mantém a ordem visual do HTML.
           */

          const scoreIda =
            legs[0]
              ? legs[0].querySelector(
                  '.m360-ko-score'
                )
              : null;


          adicionarPenaltis(
            scoreIda,
            confronto,
            false
          );


          adicionarStatusJogo(
            legs[0],
            confronto.status_jogo_ida
          );


          /*
           * Volta:
           * status + pênaltis.
           */

          const scoreVolta =
            legs[1]
              ? legs[1].querySelector(
                  '.m360-ko-score'
                )
              : null;


          adicionarPenaltis(
            scoreVolta,
            confronto,
            true
          );


          adicionarStatusJogo(
            legs[1],
            confronto.status_jogo_volta
          );

        }
      );

  }


  /* =======================================================
     NAVEGAÇÃO ENTRE FASES
     ======================================================= */

  function initPhaseNavigation(
    root
  ){

    if (
      isLiga
    ){

      return;

    }


    const title =
      root.querySelector(
        '.m360-stage-title'
      );


    const buttons =
      root.querySelectorAll(
        '.m360-stage-btn'
      );


    const prev =
      buttons[0] || null;


    const next =
      buttons[1] || null;


    let currentIndex =
      fases.findIndex(
        function(fase){

          return (
            fase.slug ===
            activeSlug
          );

        }
      );


    if (
      currentIndex < 0
    ){

      currentIndex = 0;

    }


    function activatePhase(
      index
    ){

      if (
        !fases.length
      ){

        return;

      }


      if (
        index < 0
      ){

        index =
          fases.length - 1;

      }


      if (
        index >= fases.length
      ){

        index = 0;

      }


      currentIndex =
        index;


      root
        .querySelectorAll(
          '.m360-section'
        )
        .forEach(
          function(section){

            section.classList.remove(
              'active'
            );

          }
        );


      const fase =
        fases[
          currentIndex
        ];


      if (!fase){

        return;

      }


      const section =
        root.querySelector(
          '#' +
          CSS.escape(
            fase.id
          )
        );


      if (section){

        section.classList.add(
          'active'
        );

      }


      if (title){

        title.textContent =
          fase.title ||
          '';

      }


      root.dataset.phaseIndex =
        String(
          currentIndex
        );

    }


    if (prev){

      prev.addEventListener(
        'click',
        function(event){

          event.preventDefault();

          event.stopPropagation();

          activatePhase(
            currentIndex - 1
          );

        }
      );

    }


    if (next){

      next.addEventListener(
        'click',
        function(event){

          event.preventDefault();

          event.stopPropagation();

          activatePhase(
            currentIndex + 1
          );

        }
      );

    }


    activatePhase(
      currentIndex
    );

  }


  /* =======================================================
     NAVEGAÇÃO ENTRE RODADAS
     ======================================================= */

  function initRoundNavigation(
    root
  ){

    const widgets =
      root.querySelectorAll(
        '.m360-round-widget'
      );


    widgets.forEach(
      function(widget){

        if (
          widget.dataset.m360RoundInitialized ===
          '1'
        ){

          return;

        }


        widget.dataset.m360RoundInitialized =
          '1';


        const panels =
          Array.from(
            widget.querySelectorAll(
              '.m360-round-panel'
            )
          );


        if (
          !panels.length
        ){

          return;

        }


        const prev =
          widget.querySelector(
            '.m360-round-prev'
          );


        const next =
          widget.querySelector(
            '.m360-round-next'
          );


        const title =
          widget.querySelector(
            '.m360-round-title'
          );


        let index =
          Number(
            widget.dataset.roundIndex ||
            0
          );


        if (
          !Number.isFinite(index) ||
          index < 0 ||
          index >= panels.length
        ){

          index = 0;

        }


        function activateRound(
          nextIndex
        ){

          if (
            !panels.length
          ){

            return;

          }


          if (
            nextIndex < 0
          ){

            nextIndex =
              panels.length - 1;

          }


          if (
            nextIndex >= panels.length
          ){

            nextIndex = 0;

          }


          index =
            nextIndex;


          panels.forEach(
            function(panel){

              panel.classList.remove(
                'active'
              );

            }
          );


          const panel =
            panels[index];


          if (panel){

            panel.classList.add(
              'active'
            );


            if (title){

              title.textContent =
                panel.dataset.roundName ||
                'Rodada';

            }

          }


          widget.dataset.roundIndex =
            String(index);

        }


        if (prev){

          prev.addEventListener(
            'click',
            function(event){

              event.preventDefault();

              event.stopPropagation();

              activateRound(
                index - 1
              );

            }
          );

        }


        if (next){

          next.addEventListener(
            'click',
            function(event){

              event.preventDefault();

              event.stopPropagation();

              activateRound(
                index + 1
              );

            }
          );

        }


        activateRound(
          index
        );

      }
    );

  }


  /* =======================================================
     INICIALIZAÇÃO DO WIDGET
     ======================================================= */

  function initCompetition(
    root
  ){

    if (!root){

      return;

    }


    if (
      root.dataset.m360Initialized ===
      '1'
    ){

      return;

    }


    root.dataset.m360Initialized =
      '1';


    aplicarDadosMataMata(
      root
    );


    initPhaseNavigation(
      root
    );


    initRoundNavigation(
      root
    );

  }


  /* =======================================================
     LOCALIZAR TODOS OS WIDGETS
     ======================================================= */

  function initAll(){

    document
      .querySelectorAll(
        '.m360-competicao'
      )
      .forEach(
        initCompetition
      );

  }


  /* =======================================================
     EXECUÇÃO
     ======================================================= */

  if (
    document.readyState ===
    'loading'
  ){

    document.addEventListener(
      'DOMContentLoaded',
      initAll
    );

  } else {

    initAll();

  }


  /* =======================================================
     COMPATIBILIDADE ELEMENTOR
     ======================================================= */

  if (
    window.jQuery
  ){

    window.jQuery(
      document
    ).on(
      'elementor/frontend/init',
      function(){

        setTimeout(
          initAll,
          50
        );

      }
    );

  }


})();

</script>
`;


// ============================================================
// 6. WRAPPER
//
// O 8.2 entrega somente conteúdo estrutural.
// Garantimos um único container do widget.
// ============================================================

let htmlFinal =
  htmlBase;


const possuiWrapper =
  /<div[^>]+class=["'][^"']*\bm360-competicao\b[^"']*["'][^>]*>/i
    .test(
      htmlFinal
    );


if (
  !possuiWrapper
){

  htmlFinal = `

<div
  class="m360-competicao"
  data-m360-widget="competicao"
>

${htmlFinal}

</div>

`;

}


// ============================================================
// 7. INSERÇÃO CSS + HTML + JS
// ============================================================

const htmlComEstilo =
  css +
  '\n' +
  htmlFinal +
  '\n' +
  javascript;


// ============================================================
// 8. METADADOS
// ============================================================

const metaAnterior =
  data.meta_html || {};


const meta_html = {

  ...metaAnterior,

  versao:
    'HTML1_MODULAR_v1_8.3.2',

  etapa:
    '8.3',

  objetivo:
    'APLICAR_CSS_JAVASCRIPT',

  modelo:
    metaAnterior.modelo ||
    (
      isLiga
        ? 'PONTOS_CORRIDOS'
        : 'COPA'
    ),

  idioma:
    data.idioma ||
    metaAnterior.idioma ||
    'pt-BR',

  possui_grupos:
    Boolean(
      metaAnterior.possui_grupos
    ),

  possui_classificacao:
    Boolean(
      metaAnterior.possui_classificacao
    ),

  possui_mata_mata:
    Boolean(
      metaAnterior.possui_mata_mata
    ),

  possui_liga:
    Boolean(
      metaAnterior.possui_liga
    ),

  fases:
    metaAnterior.fases ||
    {},

  conteudo_gerado:
    true,

  css_gerado:
    true,

  javascript_gerado:
    true,

  cache_salvo:
    false,

  ajuste_layout_liga:
    '7fr_3fr_desktop_mobile_700px'

};


// ============================================================
// 9. SAÍDA CANÔNICA
// ============================================================

return [

  {

    json: {

      competicao:
        data.competicao || {},

      classificacao:
        data.classificacao || {},

      grupos:
        data.grupos || {},

      mata_mata:
        data.mata_mata || {},

      liga:
        data.liga || {},

      tipo_publicacao:
        data.tipo_publicacao || '',

      idioma:
        data.idioma || 'pt-BR',

      i18n:
        data.i18n || {},

      widget_nome:
        data.widget_nome || '',

      isLiga,

      activeSlug,

      fases,

      conteudoHTML:
        htmlComEstilo,

      html:
        htmlComEstilo,

      origem:
        'n8n_dw_esportes',

      meta_html

    }

  }
];
